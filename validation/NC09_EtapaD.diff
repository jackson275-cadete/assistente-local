+package br.local.assistente
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PersistenciaMonitorTest {
+    @Test fun historicoNaoEhRegistradoSeTimestampFalhar() {
+        var chamadas = 0
+        val ok = PersistenciaMonitor.registrarHistorico({ _, _ -> false }, 100L) { chamadas++; true }
+        assertFalse(ok)
+        assertEquals(0, chamadas)
+    }
+
+    @Test fun historicoEhRegistradoDepoisDeTimestampConfirmado() {
+        val gravacoes = mutableListOf<Pair<String, String>>()
+        var chamadas = 0
+        val ok = PersistenciaMonitor.registrarHistorico({ k, v -> gravacoes += k to v; true }, 100L) {
+            chamadas++
+            true
+        }
+        assertTrue(ok)
+        assertEquals(listOf("ult_hist" to "100"), gravacoes)
+        assertEquals(1, chamadas)
+    }
+
+    @Test fun alertaNaoEhLiberadoSeTimestampFalhar() {
+        val gravacoes = mutableListOf<Pair<String, String>>()
+        val ok = PersistenciaMonitor.liberarAviso({ k, v -> gravacoes += k to v; false }, "bat_baixa", 200L, 3)
+        assertFalse(ok)
+        assertEquals(listOf("ult_bat_baixa" to "200"), gravacoes)
+    }
+
+    @Test fun alertaNaoEhLiberadoSeContadorFalhar() {
+        val gravacoes = mutableListOf<Pair<String, String>>()
+        val ok = PersistenciaMonitor.liberarAviso({ k, v ->
+            gravacoes += k to v
+            k.startsWith("ult_")
+        }, "quente", 300L, 4)
+        assertFalse(ok)
+        assertEquals(listOf("ult_quente" to "300", "n_quente" to "5"), gravacoes)
+    }
+
+    @Test fun alertaEhLiberadoSomenteComAsDuasGravacoesConfirmadas() {
+        val gravacoes = mutableListOf<Pair<String, String>>()
+        val ok = PersistenciaMonitor.liberarAviso({ k, v -> gravacoes += k to v; true }, "ram", 400L, 2)
+        assertTrue(ok)
+        assertEquals(listOf("ult_ram" to "400", "n_ram" to "3"), gravacoes)
+    }
+
+    @Test fun resumoDiarioNaoEhLiberadoSeDataNaoForPersistida() {
+        assertFalse(PersistenciaMonitor.liberarResumo({ _, _ -> false }, "2026-11-27"))
+        var gravado: Pair<String, String>? = null
+        assertTrue(PersistenciaMonitor.liberarResumo({ k, v -> gravado = k to v; true }, "2026-11-27"))
+        assertEquals("ult_resumo" to "2026-11-27", gravado)
+    }
+}
