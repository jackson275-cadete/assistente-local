+package br.local.assistente
+
+/** Portas de persistência do MonitorService, isoladas para validação JVM. */
+internal object PersistenciaMonitor {
+    /** Só registra uma amostra se o horário que evita duplicatas foi confirmado. */
+    fun registrarHistorico(
+        salvar: (String, String) -> Boolean,
+        agora: Long,
+        registrar: () -> Boolean
+    ): Boolean {
+        if (!salvar("ult_hist", agora.toString())) return false
+        return registrar()
+    }
+
+    /** Só libera o alerta depois de confirmar horário e contador. */
+    fun liberarAviso(
+        salvar: (String, String) -> Boolean,
+        id: String,
+        agora: Long,
+        vezes: Int
+    ): Boolean {
+        if (!salvar("ult_$id", agora.toString())) return false
+        if (!salvar("n_$id", (vezes + 1).toString())) return false
+        return true
+    }
+
+    /** O resumo diário só pode ser anunciado depois de persistir a data. */
+    fun liberarResumo(
+        salvar: (String, String) -> Boolean,
+        hoje: String
+    ): Boolean = salvar("ult_resumo", hoje)
+}
