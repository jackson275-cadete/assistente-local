+package br.local.assistente
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import kotlin.concurrent.thread
+
+class HistoricoArquivoTest {
+    @get:Rule val pasta = TemporaryFolder()
+
+    @Test fun appendPersisteEOutraInstanciaLe() {
+        val dir = pasta.newFolder("persistencia")
+        val primeiro = HistoricoArquivo(dir)
+        assertTrue(primeiro.registrar(1_800_000_000_000L, 72, 12.5f, 2048, 36.5f))
+        assertTrue(primeiro.registrar(1_800_000_900_000L, 70, 12.4f, 1980, 37f))
+        val segundo = HistoricoArquivo(dir)
+        assertEquals(2, File(dir, "historico.csv").readLines().size)
+        assertEquals(2, segundo.ultimos(10).size)
+        assertTrue(segundo.ultimos(1).single().contains("bateria 70%"))
+    }
+
+    @Test fun rejeitaMetricasInvalidasSemAcrescentarLinha() {
+        val dir = pasta.newFolder("validacao")
+        val store = HistoricoArquivo(dir)
+        assertFalse(store.registrar(1L, 140, 1f, 100, 30f))
+        assertFalse(store.registrar(1L, 50, Float.NaN, 100, 30f))
+        assertFalse(store.registrar(1L, 50, 1f, -1, 30f))
+        assertTrue(!File(dir, "historico.csv").exists())
+    }
+
+    @Test fun ignoraLinhasCsvMalformadas() {
+        val dir = pasta.newFolder("malformado")
+        File(dir, "historico.csv").writeText(
+            "linha-ruim\n1,150,2.0,300,30.0\n2,50,NaN,300,30.0\n3,60,2.0,300,31.0\n"
+        )
+        val store = HistoricoArquivo(dir)
+        assertEquals(1, store.ultimos(20).size)
+        assertEquals(5, store.quedaNaUltimaHora(3_600_003L, 55))
+    }
+
+    @Test fun compactacaoMantemAsDuasMilUltimasLinhas() {
+        val dir = pasta.newFolder("compactacao")
+        val f = File(dir, "historico.csv")
+        f.writeText((1..12_000).joinToString("\n") { "$it,50,2.0,300,30.0" } + "\n")
+        val store = HistoricoArquivo(dir)
+        assertTrue(store.registrar(20_000L, 49, 2f, 299, 30f))
+        val linhas = f.readLines()
+        assertEquals(2000, linhas.size)
+        assertEquals("10002,50,2.0,300,30.0", linhas.first())
+        assertTrue(linhas.last().startsWith("20000,49,"))
+        assertTrue(f.length() < 200_000L)
+    }
+
+    @Test fun appendConcorrenteNaoPerdeLinhas() {
+        val dir = pasta.newFolder("concorrencia")
+        val inicio = CountDownLatch(1)
+        val threads = (0 until 6).map { grupo ->
+            thread {
+                val store = HistoricoArquivo(dir)
+                inicio.await()
+                repeat(20) { n ->
+                    check(store.registrar((grupo * 100 + n).toLong(), 50, 2f, 300, 30f))
+                }
+            }
+        }
+        inicio.countDown()
+        threads.forEach { it.join() }
+        assertEquals(120, File(dir, "historico.csv").readLines().size)
+    }
+
+    @Test fun exclusaoConfirmaArquivoAusenteETrataAusenciaComoSucesso() {
+        val dir = pasta.newFolder("exclusao")
+        val store = HistoricoArquivo(dir)
+        assertTrue(store.apagar())
+        assertTrue(store.registrar(1L, 50, 2f, 300, 30f))
+        assertTrue(File(dir, "historico.csv").exists())
+        assertTrue(store.apagar())
+        assertFalse(File(dir, "historico.csv").exists())
+        assertTrue(store.apagar())
+    }
+
+    @Test fun arquivoTemporarioObsoletoEhRemovidoNaExclusao() {
+        val dir = pasta.newFolder("temporario")
+        val tmp = File(dir, "historico.csv.tmp")
+        tmp.writeText("resto")
+        assertTrue(HistoricoArquivo(dir).apagar())
+        assertFalse(tmp.exists())
+    }
+}
